<!DOCTYPE dlg:window PUBLIC "-//OpenOffice.org//DTD OfficeDocument 1.0//EN" "dialog.dtd">
<dlg:window xmlns:dlg="http://openoffice.org/2000/dialog" xmlns:script="http://openoffice.org/2000/script" dlg:id="SetupWindow" dlg:page="1" dlg:left="0" dlg:top="0" dlg:width="320" dlg:height="160" dlg:help-text="&amp;SetupWindow.HelpText" dlg:closeable="true" dlg:moveable="true" dlg:title="&amp;SetupWindow.Title" dlg:withtitlebar="false">
  <dlg:styles>
    <dlg:style dlg:style-id="0" dlg:font-weight="150"/>
  </dlg:styles>
  <dlg:bulletinboard>
    <dlg:text dlg:style-id="0" dlg:id="Label1" dlg:tab-index="0" dlg:left="10" dlg:top="10" dlg:width="305" dlg:height="20" dlg:help-text="&amp;SetupWindow.Label1.HelpText" dlg:align="center" dlg:multiline="true" dlg:page="1"/>
    <dlg:text dlg:style-id="0" dlg:id="Label2" dlg:tab-index="0" dlg:left="10" dlg:top="10" dlg:width="305" dlg:height="20" dlg:help-text="&amp;SetupWindow.Label2.HelpText" dlg:align="center" dlg:multiline="true" dlg:page="2"/>
    <dlg:text dlg:style-id="0" dlg:id="Label3" dlg:tab-index="0" dlg:left="10" dlg:top="10" dlg:width="305" dlg:height="20" dlg:help-text="&amp;SetupWindow.Label3.HelpText" dlg:align="center" dlg:multiline="true" dlg:page="3"/>
    <dlg:text dlg:style-id="0" dlg:id="Label4" dlg:tab-index="0" dlg:left="10" dlg:top="3" dlg:width="305" dlg:height="15" dlg:help-text="&amp;SetupWindow.Label4.HelpText" dlg:align="center"  dlg:valign="center" dlg:page="4"/>
    <dlg:progressmeter dlg:id="ProgressBar1" dlg:tab-index="1" dlg:left="10" dlg:top="40" dlg:width="305" dlg:height="15" dlg:help-text="&amp;SetupWindow.ProgressBar1.HelpText" dlg:value="0" dlg:page="2"/>
    <dlg:text dlg:id="Label5" dlg:tab-index="2" dlg:left="10" dlg:top="60" dlg:width="305" dlg:height="15" dlg:help-text="&amp;SetupWindow.Label5.HelpText" dlg:align="center" dlg:page="2"/>
    <dlg:text dlg:id="Label6" dlg:tab-index="1" dlg:left="10" dlg:top="40" dlg:width="305" dlg:height="95" dlg:help-text="&amp;SetupWindow.Label6.HelpText" dlg:align="center" dlg:page="3" dlg:multiline="true"/>
    <dlg:textfield dlg:id="TextField1" dlg:tab-index="1" dlg:left="10" dlg:top="20" dlg:width="305" dlg:height="115" dlg:help-text="&amp;SetupWindow.TextField1.HelpText" dlg:hscroll="true" dlg:vscroll="true" dlg:multiline="true" dlg:readonly="true" dlg:value="&amp;SetupWindow.TextField1.Text" dlg:page="4"/>
    <dlg:button dlg:id="CommandButton1" dlg:tab-index="2" dlg:left="10" dlg:top="140" dlg:width="45" dlg:height="15" dlg:help-text="&amp;SetupWindow.CommandButton1.HelpText" dlg:value="&amp;SetupWindow.CommandButton1.Label" dlg:page="4">
      <script:event script:event-name="on-performaction" script:macro-name="vnd.sun.star.UNO:Copy" script:language="UNO"/>
    </dlg:button>
    <dlg:button dlg:id="CommandButton2" dlg:disabled="true" dlg:tab-index="3" dlg:left="220" dlg:top="140" dlg:width="45" dlg:height="15" dlg:help-text="&amp;SetupWindow.CommandButton2.HelpText" dlg:value="&amp;SetupWindow.CommandButton2.Label">
      <script:event script:event-name="on-performaction" script:macro-name="vnd.sun.star.UNO:Cancel" script:language="UNO"/>
    </dlg:button>
    <dlg:button dlg:id="CommandButton3" dlg:disabled="true" dlg:tab-index="4" dlg:left="270" dlg:top="140" dlg:width="45" dlg:height="15" dlg:help-text="&amp;SetupWindow.CommandButton3.HelpText" dlg:value="&amp;SetupWindow.CommandButton3.Label">
      <script:event script:event-name="on-performaction" script:macro-name="vnd.sun.star.UNO:Next" script:language="UNO"/>
    </dlg:button>
  </dlg:bulletinboard>
</dlg:window>

