<!DOCTYPE dlg:window PUBLIC "-//OpenOffice.org//DTD OfficeDocument 1.0//EN" "dialog.dtd">
<dlg:window xmlns:dlg="http://openoffice.org/2000/dialog" xmlns:script="http://openoffice.org/2000/script" dlg:id="OptionsDialog" dlg:left="0" dlg:top="0" dlg:width="279" dlg:height="225" dlg:help-text="&amp;OptionsDialog.HelpText" dlg:closeable="true" dlg:moveable="true" dlg:title="&amp;OptionsDialog.Title" dlg:withtitlebar="false">
  <dlg:styles>
    <dlg:style dlg:style-id="0" dlg:font-weight="150"/>
  </dlg:styles>
  <dlg:bulletinboard>
    <dlg:titledbox dlg:id="FrameControl1" dlg:tab-index="0" dlg:left="0" dlg:top="0" dlg:width="279" dlg:height="140" dlg:help-text="&amp;OptionsDialog.FrameControl1.HelpText">
      <dlg:title dlg:value="&amp;OptionsDialog.FrameControl1.Label"/>
    </dlg:titledbox>
    <dlg:fixedline dlg:style-id="0" dlg:id="FixedLine1" dlg:left="5" dlg:top="140" dlg:width="268" dlg:height="15" dlg:help-text="&amp;OptionsDialog.FixedLine1.HelpText" dlg:value="&amp;OptionsDialog.FixedLine1.Label"/>
    <dlg:text dlg:id="Label1" dlg:tab-index="1" dlg:left="10" dlg:top="160" dlg:width="40" dlg:height="15" dlg:help-text="&amp;OptionsDialog.Label1.HelpText" dlg:value="&amp;OptionsDialog.Label1.Label" dlg:valign="center"/>
    <dlg:menulist dlg:id="ListBox1" dlg:tab-index="2" dlg:disabled="true" dlg:left="84" dlg:top="160" dlg:width="90" dlg:height="15" dlg:help-text="&amp;OptionsDialog.ListBox1.HelpText" dlg:spin="true">
      <dlg:menupopup>
        <dlg:menuitem dlg:value="&amp;OptionsDialog.ListBox1.StringItemList.0" dlg:selected="true"/>
        <dlg:menuitem dlg:value="&amp;OptionsDialog.ListBox1.StringItemList.1"/>
        <dlg:menuitem dlg:value="&amp;OptionsDialog.ListBox1.StringItemList.2"/>
      </dlg:menupopup>
    </dlg:menulist>
    <dlg:button dlg:id="CommandButton1" dlg:tab-index="3" dlg:left="184" dlg:top="160" dlg:width="90" dlg:height="15" dlg:help-text="&amp;OptionsDialog.CommandButton1.HelpText" dlg:value="&amp;OptionsDialog.CommandButton1.Label">
      <script:event script:event-name="on-performaction" script:macro-name="vnd.sun.star.UNO:ShowSetup" script:language="UNO"/>
    </dlg:button>
    <dlg:text dlg:style-id="0" dlg:id="Label2" dlg:tab-index="4" dlg:left="10" dlg:top="185" dlg:width="259" dlg:height="25" dlg:help-text="&amp;OptionsDialog.Label2.HelpText" dlg:value="&amp;OptionsDialog.Label2.Label" dlg:align="center" dlg:valign="center" dlg:multiline="true"/>
  </dlg:bulletinboard>
</dlg:window>
